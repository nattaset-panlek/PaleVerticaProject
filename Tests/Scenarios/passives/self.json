    {
      "do": "Reset"
    },
    {
      "do": "Give",
      "passives": [
        "OathOfSilence"
      ]
    },
    {
      "do": "Cast",
      "slot": 0,
      "at": "target",
      "wait": 1.5
    },
    {
      "do": "Expect",
      "name": "Oath of Silence: a skill with cast time does not fire",
      "value": "cast",
      "to": 0,
      "severity": "review",
      "note": "Review if slot 1 holds an instant skill, which Oath of Silence allows."
    }
  ]
