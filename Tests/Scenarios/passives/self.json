        {
          "do": "Cast",
          "slot": 0,
          "at": "target",
          "wait": 1.1
        },
        {
          "do": "Refill",
          "of": "player"
        }
      ]
    },
    {
      "do": "Expect",
      "name": "Whisper Pact: repeated casts lower max hp",
      "value": "player.MaxHP",
      "op": "<",
      "to": "var.mh"
