  m_Name: 
  m_EditorClassIdentifier: 
  Details: "<color=#FF9F04>PhysicalAttack</color> \tAdds a minor amount to physical
    attack damage (1/3 of LUK).\r\n<color=#FF9F04>MagicalAttack</color> \tIncreases
    magical attack (1/3 of LUK).\r\n<color=#FF9F04>CriticalRate</color> \tAdds to
    critical rate at about 1 point per 1.5 points of LUK, capped at 100%.\r\n<color=#FF9F04>HitAndDodge</color>\tHas
    a small effect on HitValue and DodgeValue."
